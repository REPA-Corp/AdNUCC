<!DOCTYPE html>
<html lang="en">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">


<%- include('./partials/head.ejs') %>

<body style="background-color:#hsl(219, 65%, 92%);">

    <%- include('./partials/nav.ejs') %>

    <div id="wholeBox">
        <div id="rightBox">
            <img src="/logo.png" alt="AdNUCC logo" style="height: 200px;">
            <h2 style="text-align: center;">Welcome to 
                <br>ADNU Course Compass!</h2>
                <p>Discover what fellow students have to say about your <br>the courses being offered by each department. </p>
        </div>



        <div id='leftBox'>
            <p id="alertBox">a</p>

            <div id="loginBox" section="loginB">
                <h2 class = "logintitle">Login</h2>
                <form id="log">
                    <div>
                        <label for="Lemail">Email</label>
                        <input type="email" name="Lemail" id="Lemail" required>
                    </div>
                    <div class="passBox">
                        <label for="Lpassword">Password</label>
                        <input type="password" name="Lpassword" id="Lpassword" required>
                         <i id="eye-Lpass" class="fas fa-eye"></i>


                    </div>
                    <button id="LsubmitBTN" type="submit">Sign In</button>
                </form>    
                 <p>Don't have an account yet? <a href="#" id="reghere">Register</a></p>

            </div>
       
            <div id="registerBox" style="margin: px;">
                <h2 class="logintitle">Register</h2>

            <form id="regis">
                <div>
                    <label for="email">Email</label>
                    <input type="email" name="email" id="email" required>
                </div>
                <div class="passBox">
                    <label for="password">Password</label>
                    <input type="password" name="password" id="password" required>
                    <i id="eye-pass" class="fas fa-eye"></i>
                </div>
                <div class="passBox">
                    <label for="confirmPassword">Confirm Password</label>
                    <input type="password" name="confirmPassword" id="confirmPassword" required>
                    <i id="eye-Cpass" class="fas fa-eye"></i>

                </div>
                <div>
                    <label for="department">Select Department</label>
                    <select id="departmentDropdown" name="department">
                        <option value="">Select a Department</option>
                        <option value="College of Business">College of Business</option>
                        <option value="College of Computer Studies">College of Computer Studies</option>
                        <option value="College of Education">College of Education</option>
                        <option value="College of Nursing">College of Nursing</option>
                        <option value="College of Humanities and Social Sciences">College of Humanities and Social Sciences </option>
                        <option value="College of Science, Engineering and Architecture">College of Science, Engineering and Architecture</option>
                    </select>
                </div>
                <div>
                    <label for="course">Select Course</label>
                    <select id="courseDropdown" name="course" class="courses">
                    <optionvalue="">Select a Course</option>
                        <!-- Courses will be populated here based on department selection -->
                    </select>
                </div>
                <button id="signupBTN" type="submit">Submit</button>
            </form>
                <p style = "text-align:center">Already registered? <a href="#" id="loghere">Sign In</a></p>
            </div>
        
            
        </div>

    </div>

    
    <%- include('./partials/footer.ejs') %>
    <script type="module" src="/firebase.js"></script>
    <script src="/index.js"></script>
    
</body>
</html>