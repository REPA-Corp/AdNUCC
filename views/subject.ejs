<!DOCTYPE html>
<html lang="en">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css" integrity="sha512-5Hs3dF2AEPkpNAR7UiOHba+lRSJNeM2ECkwxUIxC1Q/FLycGTbNapWXB4tP889k5T5Ju8fs4b1P5z/iB4nMfSQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />

<%- include('./partials/head.ejs') %>

<body>
    <%- include('./partials/nav.ejs') %>
<section id="main-temp">


<section id="main-content">
    <p id="breadCrumbs" style="padding: 0px 20px;"></p>

    <div id="subjectBox" style="display: flex; padding: 50px 50px 0 50px ; justify-content:space-between;">

    <div style="display:flex; gap: 20px;">
        <span id="go-back-btn" style="display:flex; align-items:center;"><i class="fa fa-arrow-left fa-xl" aria-hidden="true" style="padding:10px"></i></span>
         <div id="subjectData">
        
                    <h2 style="display:flex; gap: 12px; align-items:center">
                    <%= subject.subjectCode %>
                        <% let sum = 0 %>
                        <% reviews.forEach(e => {  const reviewData = e.data()%> 
                            <%  sum += reviewData.rating; %>
                        <%  }) %>

                        <% let avg = sum / reviews.size; %>

                        <div style="display:flex; align-items:center; font-size: 24px;"> 
                            
                            <h2 id="avgRating" style="font-size: 24px; margin-right: 12px; font-weight: normal">(<%= avg.toFixed(1) %></h2> <!-- Displays avg with 2 decimal places -->
                            <% avg = parseInt(sum /  reviews.size); %>
                            
                            <% if(avg == 1){ %>
                                <div class="avgStars" >
                                    <h1 style="color: gold;">★</h1><h1 style="color:gray;">★★★★</h1>
                                </div>
                            <% } else if(avg == 2){ %>
                                <div class="avgStars">
                                    <h1 style="color: gold;">★★</h1><h1 style="color:gray;">★★★</h1>
                                </div>
                            <% } else if(avg == 3){ %>
                                <div class="avgStars">
                                    <h1 style="color: gold;">★★★</h1><h1 style="color:gray;">★★</h1>
                                </div>
                            <% } else if(avg == 4){ %>
                                <div class="avgStars">
                                    <h1 style="color: gold;">★★★★</h1><h1 style="color:gray;">★</h1>
                                </div>
                            <% } else { %>
                                <div class="avgStars">
                                    <h1 style="color: gold;">★★★★★</h1>
                                </div>
                                
                            <% } %>
                            <span style="font-size:24px; font-family: 'Oxygen'; font-weight: normal">)</span>
                        </div>
                
                    </h2>
                    <h3><%= subject.subjectTitle %></h3>
        
         </div>
    </div>
        <div id="rate-box-div">
            <div id="rate-box">Rate This Subject</div>
        </div>
    
    </div>
     <!-- Modal -->
     <form id="ratingModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <div id="closeIn" style="cursor: pointer;display: flex;justify-content: space-between;">
                    <h1 style="text-align: center;">Rate this Subject</h1>
            </div>
         
            <div class="star-rating">
                <input type="radio" id="star5" name="rating" value="5"><label for="star5">★</label>
                <input type="radio" id="star4" name="rating" value="4"><label for="star4">★</label>
                <input type="radio" id="star3" name="rating" value="3"><label for="star3">★</label>
                <input type="radio" id="star2" name="rating" value="2"><label for="star2">★</label>
                <input type="radio" id="star1" name="rating" value="1"><label for="star1">★</label>
            </div>

            <h2 id="emoticons"></h2>

            <h3 style="text-align: left;">Review</h3>
            <textarea minlength="10" maxlength="1000"  name="reviewTXT" id="reviewTXT" required></textarea>
            <p>Characters: <span id="charCount">0</span>/1000</p>
            <button class="tanga" type="submit">Submit</button>
        </div>
    </form>

    <div style="display: flex; justify-content: space-between; border-bottom:2px solid gainsboro; padding: 20px 50px">

         <div id="reviewCount">
            <h2><%= reviews.size %> Reviews</h2>
        </div>
    </div>
    
    <div id="temp">
    <% if(reviews.empty) { %>
        <h5 style="margin: 0px 60px; font-size: 15px;">There are no reviews to show</h5> 
   <% }%>
    <% reviews.forEach(e => {  const reviewData = e.data()%> 
    <div id="reviews">
        <div id="reviewBox1">
                <div id="reviewUSN">
                    <img src="https://www.gravatar.com/avatar?d=mp&size=200" alt="Anonymous Avatar" style="border-radius: 50%; max-width: 50px;">

                    <h2><%= reviewData.username %></h2>
                </div>
                <div>
                    <h3><%= reviewData.rating %>.0 
                        <% if (reviewData.rating == 1) { %>
                            star
                        <% } else { %>
                            stars
                        <% } %>
                    </h3>
                    
                </div>
         
            <div>
                <% if(reviewData.rating == 1){ %>
                    <div class="reviewStars" >
                        <h1 style="color: gold;">★</h1><h1>★★★★</h1> 
                    </div>
               <% }else if(reviewData.rating == 2){ %>
                    <div class="reviewStars" >
                        <h1 style="color: gold;">★★</h1><h1>★★★</h1> 
                    </div>
               <% }else if(reviewData.rating == 3){ %>
                    <div class="reviewStars" >
                        <h1 style="color: gold;">★★★</h1><h1>★★</h1> 
                    </div>
               <% }else if(reviewData.rating == 4){ %>
                <div class="reviewStars" >
                    <h1 style="color: gold;">★★★★</h1><h1>★</h1> 
                </div>
                <% }else{ %>
                    <div class="reviewStars" >
                        <h1 style="color: gold;">★★★★★</h1>
                    </div>
                <% } %>
              
            </div>

        </div>

        <div id="reviewBox2">
            <p><%= reviewData.comment %></p>
            <span style="display: flex; text-align: end; justify-content: flex-end; margin-top: auto; color:#888">Posted at: 
                <% 
                    const fullTimestamp = reviewData.timestamp.toDate(); 
                    const datePart = fullTimestamp.toDateString();
                    const timePart = fullTimestamp.toLocaleTimeString(); 
                %>
                <%= timePart %>, <%= datePart %> 
            </span>
                       
        </div>
    </div>  


    <%  }) %>
</div>
</div>

</section>
</section>


    <%- include('./partials/footer.ejs') %>
    <script src="/subject.js"></script>    

    <script type="module" src="/firebase.js"></script>    
</body>
</html>