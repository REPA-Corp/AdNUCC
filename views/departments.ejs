<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head.ejs') %>

<body>

    <!-- reuse the nav dynamically -->
    <%- include('./partials/nav.ejs') %>
    <section id="main">

                <section id="main-content">

                    <!-- posting the departments dynamically -->
                        
               <h2  id="galleryTitle">Departments</h2>
                <p style="padding:0px 20px; color: gray;">Select your preferred Department</p>
                <div class="gallery">
                    <% departmentsData.forEach(e => { 
                        const data = e.data(); 
                    %>
                    <a href="/departments/<%= data.departmentId %>">

                    <div class="gallery-item">
                        <h2 style="color: white;" id="dept"><%= data.departmentName %></h2>
                    </div>
                    </a>

                    <% }) %>
                </div>
            </section>
    </section>
    <div>
        

    </div>

    <script type="module" src="/firebase.js"></script>    
</body>

<%- include('./partials/footer.ejs') %>
</html>