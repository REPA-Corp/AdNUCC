<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head.ejs') %>

<body>
    <%- include('./partials/nav.ejs') %>

<h2 style="padding: 20px;">Departments</h2>

    <div class="gallery">
        <% departmentsData.forEach(e => { 
             const data = e.data(); 
        %>
        <a href="/departments/<%= data.departmentId %>">

          <div class="gallery-item">
              <h2 style="color: white;" id="dept"><%= data.departmentName %></h2>
          </div>
        </a>

        <% }) %>
      </div>


    <script type="module" src="/firebase.js"></script>    
</body>
</html>